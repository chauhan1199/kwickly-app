# ─── Kwickly Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED: Server will not start without this
MONGO_URI=mongodb://127.0.0.1:27017/kwickly

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Server will not start without this. Use a strong random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend/admin panel URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── Admin Defaults (used only on first startup seeding) ─────────────────────
ADMIN_DEFAULT_EMAIL=admin@kwickly.com
ADMIN_DEFAULT_PASSWORD=ChangeMe@123

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
# Set to true to send real SMS (configure the gateway in sms.service.js)
ENABLE_REAL_SMS=false
# Static OTP for development testing (only used when ENABLE_REAL_SMS=false)
DEV_STATIC_OTP=4729

# ─── SMS Gateway Credentials (choose one, add credentials when ENABLE_REAL_SMS=true)
# Fast2SMS:
# FAST2SMS_API_KEY=your_key_here
# Twilio:
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91:
# MSG91_API_KEY=your_key
# MSG91_TEMPLATE_ID=your_template_id
