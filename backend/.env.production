# ══════════════════════════════════════════════════════════════
#  KWICKLY PRODUCTION ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control.

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ────────────────────────────────────────────────
MONGO_URI=mongodb://your-mongodb-host:27017/kwickly

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379

# ─── Authentication ──────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=24h

# ─── Razorpay (Payments) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# ─── Cloudinary (Image Uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=ap6ozddu
CLOUDINARY_API_KEY=173621885894797
CLOUDINARY_API_SECRET=mm-__IJCIyDQRFXbJRpGQhIezhg

# ─── SMS Provider ────────────────────────────────────────────
ENABLE_REAL_SMS=true
# Choose one provider and uncomment:
# FAST2SMS_API_KEY=your-fast2sms-key
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://admin.kwickly.com,https://kwickly.com

# ─── App Info ────────────────────────────────────────────────
APP_NAME=Kwickly
APP_URL=https://kwickly.com
ADMIN_URL=https://admin.kwickly.com
